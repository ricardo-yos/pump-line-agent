# ----------------------------------------------------------------------
# pump-line-agent config
# ----------------------------------------------------------------------
# Default example: OpenAI-compatible endpoint with gpt-oss-120b.
# The agent was designed to work with any OpenAI-compatible provider.
# Switch providers by changing LLM_BASE_URL + LLM_AGENT_MODEL — the
# matching key below is selected automatically (see make_client), so you
# never move keys around.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_AGENT_MODEL=openai/gpt-oss-120b

# Max output tokens per LLM call. 2000 gives enough room for engineering
# explanations and candidate comparisons. Lower this if the provider
# enforces strict output-token-per-minute limits.
LLM_MAX_TOKENS=2000

# Optional: disables hidden "thinking" tokens on models that support this
# param, which is what actually exceeds tight output-token rate limits
# (e.g. Groq's OTPM cap on qwen/qwen3.6-27b). For qwen3.6-27b specifically,
# Groq documents "none" (no thinking) vs "default" (thinking mode) - leave
# unset for providers/models that don't accept this param (most don't).
# LLM_REASONING_EFFORT=none

# --- Other provider examples (change LLM_BASE_URL; the matching key is auto-selected) ---
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_AGENT_MODEL=qwen/qwen3.6-27b
# Together:    LLM_BASE_URL=https://api.together.xyz/v1
# DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1
# Anthropic:   LLM_BASE_URL=https://api.anthropic.com/v1, LLM_AGENT_MODEL=claude-sonnet-4-6
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1 (model slugs are provider/model, e.g. deepseek/deepseek-v4-flash; see openrouter.ai/models)

# --- Provider keys: fill in the one(s) you use. make_client() picks by provider. ---
# OPENAI_API_KEY also covers Together / DeepSeek (OpenAI-compatible endpoints).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
MANUS_API_KEY=
